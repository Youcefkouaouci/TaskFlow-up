# Ports
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=5173
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081

# Base de données MongoDB
MONGO_URI=mongodb://mongodb:27017/taskflow
MONGO_DB_NAME=taskflow

# Sécurité & Auth (à renseigner dans votre fichier .env local)
JWT_SECRET=

# Configuration SMTP (optionnelle en dev — mode simulation si vide)
APP_NAME=TaskFlow
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TaskFlow

VITE_API_URL=http://localhost:3000/api
