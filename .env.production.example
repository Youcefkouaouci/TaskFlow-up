# ============================================================================
# TaskFlow - Configuration de Production (VPS + Nom de domaine HTTPS)
# Copiez ce fichier vers .env sur votre VPS : cp .env.production.example .env
# ============================================================================

# Votre nom de domaine (sans https://), ex: taskflow.mondomaine.fr ou mondomaine.fr
DOMAIN_NAME=

# Base de données
MONGO_DB_NAME=taskflow

# Clé secrète JWT (générez une chaîne longue aléatoire : openssl rand -hex 32)
JWT_SECRET=

# Configuration SMTP (Gmail ou autre) pour les invitations et mots de passe oubliés
APP_NAME=TaskFlow
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TaskFlow
